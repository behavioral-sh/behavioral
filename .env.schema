# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN)
#
# autoresearch secrets:
# - local and remote development: use a 1Password service account token
# - set OP_SERVICE_ACCOUNT_TOKEN in the environment that launches research
#
# ---

# @sensitive @required
OP_SERVICE_ACCOUNT_TOKEN=

# @sensitive @required
HF_TOKEN=op(op://behavioral-dev/HF_TOKEN/credential)

# @sensitive @required
YDC_API_KEY=op(op://behavioral-dev/YDC_API_KEY/credential)

# @sensitive @required
OPENROUTER_API_KEY=op(op://behavioral-dev/OPENROUTER_API_KEY/credential)
